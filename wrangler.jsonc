{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "net-time",
	"compatibility_date": "2026-10-24",
	"compatibility_flags": ["nodejs_compat"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// Spec rate-limit buckets. period must be 10 or 60; counts are per Cloudflare location, eventually consistent.
	"ratelimits": [
		{ "name": "RL_GLOBAL", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
		{ "name": "RL_WRITE", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
		{ "name": "RL_AUTH", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } }
	],
	"workers_dev": true,
	"preview_urls": true
}
