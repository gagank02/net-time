{
	"name": "net-time",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types --check --env-file .dev.vars.example && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "vitest run --coverage",
		"test:e2e": "playwright install chromium webkit && playwright test",
		"gen": "wrangler types --env-file .dev.vars.example",
		"deploy": "npm run build && wrangler deploy",
		"audit": "npm audit --audit-level=high",
		"db:setup": "psql -v ON_ERROR_STOP=1 -d postgres -f scripts/db-setup.sql",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:seed": "node scripts/db-seed.ts",
		"courts:build-seed": "node scripts/build-courts-seed.ts",
		"data:classes": "node scripts/fetch-classes.ts && prettier --write data/classes.cpd.json data/classes.report.md"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24",
		"@types/pg": "^8.23.1",
		"@vitest/browser-playwright": "^5.0.5",
		"@vitest/coverage-v8": "^4.1.12",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1",
		"wrangler": "^4.97.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"engines": {
		"node": ">=24"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"workerd@1.20261019.1": true
	},
	"dependencies": {
		"drizzle-orm": "^0.45.4",
		"maplibre-gl": "^6.16.0",
		"pg": "^8.23.1",
		"zod": "^4.6.7"
	},
	"overrides": {
		"miniflare": {
			"undici": "7.30.1"
		},
		"@esbuild-kit/core-utils": {
			"esbuild": "0.25.12"
		}
	}
}
