{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		// wrangler types imports the built worker (.svelte-kit/cloudflare/_worker.js) for ctx.exports typing;
		// we only write TS, so skip type-checking JS build output.
		"checkJs": false,
		"types": ["$app/types", "node", "./worker-configuration.d.ts"]
	},
	"include": ["src", "vite.config.ts", "playwright.config.ts"]
}
